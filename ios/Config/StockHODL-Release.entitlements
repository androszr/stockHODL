<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Without this the system refuses to run a passkey ceremony for the
	     relying party at all, which is why the paid Apple Developer Program is
	     a hard dependency of this stage and not a nicety (plan B.2).

	     Apple fetches /.well-known/apple-app-site-association from this exact
	     host through its own CDN and caches it for up to a day. If the
	     association looks broken right after a change, reinstall before
	     debugging anything else; append `?mode=developer` on a debug build to
	     bypass the CDN. The route that serves the file is
	     src/app/.well-known/apple-app-site-association/route.ts and it answers
	     404 until APPLE_APP_ID is set in the environment. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>webcredentials:sawa-finance.vercel.app</string>
	</array>

	<!-- Claimed in C1, used since C2 for the payload snapshot, and read by the
	     widget extension since the widgets landed — which is exactly the
	     "addition rather than a migration" the early claim was for (plan A.8).
	     Kept as a literal rather than $(APP_GROUP): SnapshotStore.swift names
	     it in Swift too, and a container that silently resolves to nothing is
	     the one failure mode worth making greppable. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.robertandrosz.stockhodl</string>
	</array>

	<!-- The shared keychain scope. The widget runs as its own process with its
	     own keychain view, so the session token has to live somewhere both can
	     query; without this the widget is permanently signed out beside a
	     signed-in app. Expanded from KEYCHAIN_ACCESS_GROUP in Base.xcconfig so
	     the app and the extension cannot spell it differently.

	     Adding it also changes what the EXISTING item matches — see
	     MigratingTokenStore.swift, which is what stops this from signing every
	     current install out on update. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(KEYCHAIN_ACCESS_GROUP)</string>
	</array>

	<!-- The PRODUCTION APNs environment, which is what every signed
	     distribution build must claim — TestFlight included. TestFlight is not
	     a "beta" as far as push is concerned: it is a distribution build, its
	     device tokens are production tokens, and App Store Connect refuses an
	     upload that claims `development` here.

	     This file exists ONLY because of that one key. Everything above is
	     identical to StockHODL.entitlements, and a change there that is not
	     mirrored here ships a Release build missing a capability the Debug
	     build had — which is why ios.yml diffs the two and fails on any
	     difference other than this line. -->
	<key>aps-environment</key>
	<string>production</string>
</dict>
</plist>
