{
  "name": "stockhodl",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "gen:icons": "node scripts/gen-icons.mjs",
    "contracts:gen": "node --import tsx scripts/gen-swift-contracts.mjs",
    "tokens:gen": "node scripts/gen-swift-tokens.mjs",
    "ios:gen": "pnpm contracts:gen && pnpm tokens:gen",
    "probe:massive": "NODE_OPTIONS='--conditions=react-server' tsx scripts/massive-probe.ts",
    "recover": "NODE_OPTIONS='--conditions=react-server' tsx scripts/recover.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@better-auth/passkey": "1.6.26",
    "@neondatabase/serverless": "1.1.0",
    "better-auth": "1.6.26",
    "decimal.js": "10.6.0",
    "drizzle-orm": "0.45.2",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "dotenv": "17.4.2",
    "drizzle-kit": "0.31.10",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "quicktype": "26.0.0",
    "tsx": "4.23.11",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "packageManager": "pnpm@11.20.0"
}
