# Copy to .env (gitignored) and fill in. Never commit real values.

# --- Database ---------------------------------------------------------------
# Neon connection string (use the POOLED URL for the app, DIRECT for migrations
# if you ever hit a driver that needs it).
DATABASE_URL="postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/stockhodl?sslmode=require"

# --- Auth -------------------------------------------------------------------
# Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=""

# Must exactly match the deployed origin — it is also the WebAuthn relying party.
# Changing this invalidates every registered passkey, so pick the final domain early.
BETTER_AUTH_URL="http://localhost:3000"

# The ONLY email that can ever hold an account (docs/context.md § Auth).
ALLOWED_EMAIL="you@example.com"

# Break-glass for total passkey loss (docs/context.md § Auth). Leave at 0.
# Enabling it turns on password sign-in. Set to 1 only for the minutes it takes
# to re-enroll a passkey, then set it back and redeploy:
#   pnpm recover '<a-long-temporary-password>'
RECOVERY_MODE="0"

# --- Cron -------------------------------------------------------------------
# Shared secret every /api/cron/* route checks (Vercel Cron and the
# price-alerts workflow send it as a bearer). openssl rand -hex 24
CRON_SECRET=""

# --- Market data --------------------------------------------------------------
# Massive API key. REQUIRED: the env schema validates at build time, so a
# missing value fails the build and sign-in, not just the quotes.
# Only src/lib/market-data/massive.ts may read it.
STOCK_API=""

# --- Optional -----------------------------------------------------------------
# Anthropic key for screenshot import. Absent = the import button never renders.
ANTHROPIC_API_KEY=""

# Apple application identifier, <10-char Team ID>.<bundle id>, published at
# /.well-known/apple-app-site-association so iOS lets the native client assert
# a passkey for this domain (docs/ios-native.md A.6.3). Absent = that route
# 404s, which is correct until the Apple Developer enrollment completes.
# Public by design — Apple fetches the file unauthenticated.
APPLE_APP_ID=""

# --- Push (optional) ------------------------------------------------------------
# APNs provider credentials for price alerts, the morning brief and the close
# summary. All five optional: absent = the push crons log and send nothing.
# Only src/lib/push/apns.ts reads them.
# The key id of the APNs auth key (.p8) from the Apple Developer portal.
APNS_KEY_ID=""
# Your 10-character Apple Developer Team ID.
APNS_TEAM_ID=""
# The .p8 file's contents, base64-encoded (env vars are single-line).
APNS_PRIVATE_KEY=""
# The app's bundle id, the push topic.
APNS_BUNDLE_ID=""
# sandbox | production — only the first host tried; a token the other host
# owns is retried there automatically.
APNS_ENVIRONMENT="sandbox"
